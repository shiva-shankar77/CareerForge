# =================================================================
# CareerForge Server Environment Variables
# Copy this file to .env and configure your local or cloud values
# =================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/careerforge

# JWT Authentication Secrets
JWT_SECRET=careerforge_super_secure_jwt_secret_key_2026_dev_only
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS and Socket.io)
CLIENT_URL=http://localhost:5173

# Rate Limiting Configurations
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Gemini AI API Key (Placeholder for Member 3)
GEMINI_API_KEY=your_gemini_api_key_here
